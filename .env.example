# Copy to .env and fill in real values (git-ignored). One .env covers both the
# Next.js app (auto-loaded) and the tsx scripts (--env-file-if-exists=.env).
# Never commit the filled-in file.

# Neon Postgres connection string (Neon free tier works fine).
# Used by the web app (reads) and by ingestion scripts (writes).
DATABASE_URL=

# Moralis API key - https://admin.moralis.com/web3apis (free tier, 40k CU/day).
# Only ingestion scripts need this; the deployed web app never calls Moralis.
MORALIS_API_KEY=

# Optional: shared password gate for a private beta of the deployed site.
SITE_PASSWORD=
