# Copy to .env and fill in real values (git-ignored). One .env covers both the
# Next.js app (auto-loaded) and the tsx scripts (--env-file-if-exists=.env).
# Never commit the filled-in file.

# Neon Postgres connection string (Neon free tier works fine).
# Used by the web app (reads) and by ingestion scripts (writes).
DATABASE_URL=

# Moralis API key - https://admin.moralis.com/web3apis (free tier, 40k CU/day).
# Only ingestion scripts need this; the deployed web app never calls Moralis.
MORALIS_API_KEY=

# Optional: shared password gate for a private beta of the deployed site.
SITE_PASSWORD=

# Optional: Ronin JSON-RPC endpoint for RNS (.ron) name resolution (E4).
# Falls back to the public Ronin RPC when unset; set a keyed RPC if you hit
# rate limits. The daily sync reverse-resolves holder names; the wallet page
# forward-resolves a searched .ron name live.
RONIN_RPC_URL=

# GoldRush (Covalent) API key - https://goldrush.dev (free tier).
# Used only to backfill pre-L2 Ronin history (before the May 2026 migration),
# which the free Blockscout explorer does not index.
GOLDRUSH_API_KEY=
