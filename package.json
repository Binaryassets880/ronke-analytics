{
  "name": "ronke-analytics",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "tsx --env-file-if-exists=.env db/migrate.ts",
    "backfill": "tsx --env-file-if-exists=.env scripts/backfill.ts",
    "sync": "tsx --env-file-if-exists=.env scripts/sync.ts",
    "rebuild": "tsx --env-file-if-exists=.env scripts/rebuild.ts",
    "seed-labels": "tsx --env-file-if-exists=.env scripts/seed-labels.ts",
    "fetch-traits": "tsx --env-file-if-exists=.env scripts/fetch-traits.ts",
    "probe": "tsx --env-file-if-exists=.env scripts/probe-providers.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "jsdom": "^25.0.1",
    "tailwindcss": "^4",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "vitest": "^2.1.8"
  }
}
